SHELL := /bin/bash

# Root of the design project (override if invoking make from elsewhere)
PROJECT_ROOT ?= $(CURDIR)

# ---- Optional configuration files ----
# Read before the defaults below, so they can set any variable of this file:
#   config.mk             for the whole repository (e.g. the board)
#   config/<PROJECT>.mk   for one project, read after config.mk
# Use plain assignments (=) in them. Precedence, highest first: command line,
# config/<PROJECT>.mk, config.mk, then the environment and the defaults below.
-include $(PROJECT_ROOT)/config.mk

# ---- Project name, passed from CLI ----
PROJECT ?= unset

# Every target but help (also the default goal) needs a project
ifeq ($(PROJECT),unset)
ifneq ($(filter-out help default,$(MAKECMDGOALS)),)
$(error PROJECT not set, please specify the name of the target project)
endif
endif

-include $(PROJECT_ROOT)/config/$(PROJECT).mk

# --- Xilinx installation info ----
XILINX_ROOT    ?= /opt/Xilinx
XILINX_VERSION ?= 2024.2
export XILINX_ROOT
export XILINX_VERSION

# update if you want the GUI changes propagated to the tcl
NO_UPDATE ?= 0

# Prebuilt bl31.elf, u-boot.elf and system.dtb for `boot`: a shared directory
# holding all three (BOOT_FW_DIR), or a PetaLinux project (PLNX_PROJECT, uses
# images/linux). BL31_ELF/UBOOT_ELF/SYSTEM_DTB override single files.
# ALLOW_INCOMPLETE_BOOT=1 builds without the missing ones instead of failing.
BOOT_FW_DIR ?=
PLNX_PROJECT ?=
BL31_ELF ?=
UBOOT_ELF ?=
SYSTEM_DTB ?=
ALLOW_INCOMPLETE_BOOT ?= 0

# Optional: override the impl_1 run's strategy (e.g.
# Performance_ExplorePostRoutePhysOpt) without re-synthesizing. Leave unset
# to keep whatever strategy is already on the run.
IMPL_STRATEGY ?=

# Set to 1 to make `impl` fail when timing is not met (setup, hold or pulse
# width); by default it only prints TIMING FAILED
TIMING_STRICT ?= 0

# Simulation length for `sim`, passed to xsim's run (e.g. "10 us", or "all")
SIM_TIME ?= 2000 ns

# Block design template for `new`, from scripts/bootstrap/templates/<TEMPLATE>.tcl
TEMPLATE ?= zynq_ultra

# Microblaze and stdin/stdout UART instance names in the block design, for
# `bsp` (the app builds then read them from build/<PROJECT>/bsp.mk)
MB_CPU  ?= microblaze_riscv_0
MB_UART ?= axi_uartlite_0

# ---- Board defaults (ZCU104), set them in config.mk for another board ----
NJOBS      ?= 8
PART_NAME  ?= xczu7ev-ffvc1156-2-e
BOARD_NAME ?= xilinx.com:zcu104:part0:1.1
BOARD_DTS  ?= zcu104-revc

# ---- Build/Script Dirs ----
SCRIPTS_DIR ?= $(PROJECT_ROOT)/scripts
BUILD_DIR := $(PROJECT_ROOT)/build/$(PROJECT)
MB_DIR := $(PROJECT_ROOT)/microblaze

# ---- Run commands, using scripts that setup the env ----
RUN_VITIS  := $(SCRIPTS_DIR)/env/run_vitis.sh
RUN_VIVADO := $(SCRIPTS_DIR)/env/run_vivado.sh
RUN_XSCT   := $(SCRIPTS_DIR)/env/run_xsct.sh

# ---- Block design staleness guard ----
# Stops a build whose project BD disagrees with the checked-in bd/$(PROJECT).tcl.
# See scripts/helpers/check_bd.sh for which direction each BD script moves.
# Set ALLOW_STALE_BD=1 to downgrade the check to a warning.
ALLOW_STALE_BD ?= 0
CHECK_BD := PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) NO_UPDATE=$(NO_UPDATE) \
            ALLOW_STALE_BD=$(ALLOW_STALE_BD) $(SCRIPTS_DIR)/helpers/check_bd.sh

# Set ALLOW_MISSING_PINS=1 to build a project whose BD tcl connects pins that no
# longer exist (dropping those connections) instead of failing.
ALLOW_MISSING_PINS ?= 0


.PHONY: default help new project synth impl check-bd update sim sdt boot bsp overlay dtbo deploy mb elf-mb clean-mb bit-mb check-mb-project

default: help

help:
	@echo "vivgit: make PROJECT=<name> <target> [VAR=value ...]"
	@echo ""
	@echo "Block design and Vivado project:"
	@echo "  new        create bd/<name>.tcl from a template (TEMPLATE)"
	@echo "  project    export GUI changes to bd/<name>.tcl (unless NO_UPDATE=1), recreate the .xpr"
	@echo "  update     export GUI changes to bd/<name>.tcl only"
	@echo "  check-bd   check that the project BD matches bd/<name>.tcl"
	@echo "  synth      project + synthesis"
	@echo "  impl       implementation, .bit/.bin/.xsa (IMPL_STRATEGY, TIMING_STRICT), does not re-run synth"
	@echo "  sim        behavioral simulation of testbench TB (SIM_TIME)"
	@echo ""
	@echo "Software and board:"
	@echo "  sdt        system device tree from the .xsa"
	@echo "  overlay    sdt + device-tree overlay .dtsi"
	@echo "  dtbo       compile the overlay into a .dtbo"
	@echo "  boot       BOOT.BIN (BOOT_FW_DIR or PLNX_PROJECT)"
	@echo "  deploy     stage .bin/.dtbo to a board (BOARD_DEST, BOARD_HOST;"
	@echo "             MB_PROJECT to stage the bit-mb bitstream instead)"
	@echo "  bsp        Microblaze BSP (MB_CPU, MB_UART)"
	@echo "  mb, elf-mb, clean-mb   Microblaze sub-project MB_PROJECT"
	@echo "  bit-mb     bitstream with MB_PROJECT in the Microblaze's BRAM"
	@echo ""
	@echo "Current settings (from config.mk, config/<name>.mk or defaults):"
	@echo "  PART_NAME=$(PART_NAME) BOARD_NAME=$(BOARD_NAME)"
	@echo "  BOARD_DTS=$(BOARD_DTS) XILINX_VERSION=$(XILINX_VERSION) NJOBS=$(NJOBS)"
	@echo ""
	@echo "All variables are described in scripts/README.md."

# -- shell
# Copies the template and renames its design (the `set design_name` line that
# write_bd_tcl emits) to the project. Never overwrites an existing BD tcl.
TEMPLATES_DIR := $(SCRIPTS_DIR)/bootstrap/templates
new:
	@test -f $(TEMPLATES_DIR)/$(TEMPLATE).tcl || { \
	    echo "Unknown TEMPLATE '$(TEMPLATE)', available: $$(cd $(TEMPLATES_DIR) && ls *.tcl | sed 's/\.tcl$$//' | tr '\n' ' ')"; \
	    exit 1; }
	@test ! -e $(PROJECT_ROOT)/bd/$(PROJECT).tcl || { \
	    echo "bd/$(PROJECT).tcl already exists, not overwriting it"; exit 1; }
	mkdir -p $(PROJECT_ROOT)/bd
	cp $(TEMPLATES_DIR)/$(TEMPLATE).tcl $(PROJECT_ROOT)/bd/$(PROJECT).tcl
	sed -i 's/^set design_name .*/set design_name $(PROJECT)/' $(PROJECT_ROOT)/bd/$(PROJECT).tcl

# Reports whether the project's BD matches the checked-in tcl. Run it on its own
# to check without building anything.
check-bd:
	@$(CHECK_BD) freshness

# -- vivado
project:
	@$(CHECK_BD) overwrite
ifeq ($(NO_UPDATE),0)
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/update_bd.tcl
endif
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) PART_NAME=$(PART_NAME) BOARD_NAME=$(BOARD_NAME) \
	ALLOW_MISSING_PINS=$(ALLOW_MISSING_PINS) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/create_project.tcl

synth: project
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) NJOBS=$(NJOBS) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_synth.tcl

# Implementation only -- deliberately does NOT depend on synth/project, so a
# different IMPL_STRATEGY can be tried against an existing synthesis run.
# (`project` runs create_project -force, which would discard that synthesis.)
# launch_runs will still re-run synth_1 itself if it's stale. The guard below
# catches the one case that used to pass silently: implementing a project whose
# BD is older than the checked-in tcl.
impl:
	@$(CHECK_BD) freshness
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) NJOBS=$(NJOBS) IMPL_STRATEGY=$(IMPL_STRATEGY) \
	TIMING_STRICT=$(TIMING_STRICT) $(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_impl.tcl

update:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/update_bd.tcl

sim:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) TB=$(TB) SIM_TIME="$(SIM_TIME)" \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_sim.tcl

# -- xsct
sdt:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) BOARD_DTS=$(BOARD_DTS) \
	$(RUN_XSCT) $(SCRIPTS_DIR)/xsct/generate_sdt.tcl

boot:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) BOOT_FW_DIR=$(BOOT_FW_DIR) PLNX_PROJECT=$(PLNX_PROJECT) \
	BL31_ELF=$(BL31_ELF) UBOOT_ELF=$(UBOOT_ELF) SYSTEM_DTB=$(SYSTEM_DTB) ALLOW_INCOMPLETE_BOOT=$(ALLOW_INCOMPLETE_BOOT) \
	$(RUN_XSCT) $(SCRIPTS_DIR)/xsct/generate_boot.tcl

# -- vitis
bsp:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) MB_CPU=$(MB_CPU) MB_UART=$(MB_UART) \
	$(RUN_VITIS) $(SCRIPTS_DIR)/vitis/generate_bsp.py

# -- others
overlay: sdt
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	python3 $(SCRIPTS_DIR)/helpers/generate_overlay.py

dtbo:
	dtc -@ -I dts -O dtb -o $(BUILD_DIR)/$(PROJECT).dtbo $(BUILD_DIR)/$(PROJECT)_overlay.dtsi
# Note: dtbo does not have overlay as a dependency since the user might want to modify it themself

deploy:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) BOARD_DEST=$(BOARD_DEST) BOARD_HOST=$(BOARD_HOST) \
	MB_PROJECT=$(MB_PROJECT) $(SCRIPTS_DIR)/board/deploy.sh

# -- microblaze
mb elf-mb clean-mb bit-mb: check-mb-project
check-mb-project:
	@[ -n "$(MB_PROJECT)" ] || { echo "error: MB_PROJECT not set (name of the app in microblaze/)" >&2; exit 1; }

# Installs a stub Makefile that includes scripts/bootstrap/Makefile.microblaze
mb:
	@if [ -e $(MB_DIR)/$(MB_PROJECT)/Makefile ]; then \
		echo "error: $(MB_DIR)/$(MB_PROJECT)/Makefile already exists" >&2; exit 1; fi
	@mkdir -p $(MB_DIR)/$(MB_PROJECT)
	@cp $(SCRIPTS_DIR)/bootstrap/Makefile.microblaze.stub $(MB_DIR)/$(MB_PROJECT)/Makefile
	@echo "created $(MB_DIR)/$(MB_PROJECT)/Makefile"

elf-mb:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) MB_PROJECT=$(MB_PROJECT) \
	$(MAKE) -C $(MB_DIR)/$(MB_PROJECT)

clean-mb:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) MB_PROJECT=$(MB_PROJECT) \
	$(MAKE) -C $(MB_DIR)/$(MB_PROJECT) clean

# Bitstream with the app in the Microblaze's BRAM: <PROJECT>_<MB_PROJECT>.bit/.bin
bit-mb: elf-mb
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) MB_PROJECT=$(MB_PROJECT) MB_CPU=$(MB_CPU) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_bit_mb.tcl
