SHELL := /bin/bash

# --- Xilinx installation info ----
XILINX_ROOT    ?= /opt/Xilinx
XILINX_VERSION ?= 2024.2
export XILINX_ROOT
export XILINX_VERSION

# ---- Project name, passed from CLI ----
PROJECT ?= unset

ifeq ($(PROJECT),unset)
$(error PROJECT not set, please specify the name of the target project)
endif

# update if you want the GUI changes propagated to the tcl
NO_UPDATE ?= 0

# Prebuilt bl31.elf, u-boot.elf and system.dtb for `boot`: a shared directory
# holding all three (BOOT_FW_DIR), or a PetaLinux project (PLNX_PROJECT, uses
# images/linux). BL31_ELF/UBOOT_ELF/SYSTEM_DTB override single files.
# ALLOW_INCOMPLETE_BOOT=1 builds without the missing ones instead of failing.
BOOT_FW_DIR ?=
PLNX_PROJECT ?=
BL31_ELF ?=
UBOOT_ELF ?=
SYSTEM_DTB ?=
ALLOW_INCOMPLETE_BOOT ?= 0

# Optional: override the impl_1 run's strategy (e.g.
# Performance_ExplorePostRoutePhysOpt) without re-synthesizing. Leave unset
# to keep whatever strategy is already on the run.
IMPL_STRATEGY ?=

# Simulation length for `sim`, passed to xsim's run (e.g. "10 us", or "all")
SIM_TIME ?= 2000 ns

# ---- Project specific, change them for your board ----
NJOBS      ?= 8
PART_NAME  ?= xczu7ev-ffvc1156-2-e
BOARD_NAME ?= xilinx.com:zcu104:part0:1.1
BOARD_DTS  ?= zcu104-revc

# ---- Build/Script Dirs ----
PROJECT_ROOT ?= $(CURDIR)
SCRIPTS_DIR ?= $(PROJECT_ROOT)/scripts
BUILD_DIR := $(PROJECT_ROOT)/build/$(PROJECT)
MB_DIR := $(PROJECT_ROOT)/microblaze

# ---- Run commands, using scripts that setup the env ----
RUN_VITIS  := $(SCRIPTS_DIR)/env/run_vitis.sh
RUN_VIVADO := $(SCRIPTS_DIR)/env/run_vivado.sh
RUN_XSCT   := $(SCRIPTS_DIR)/env/run_xsct.sh

# ---- Block design staleness guard ----
# Stops a build whose project BD disagrees with the checked-in bd/$(PROJECT).tcl.
# See scripts/helpers/check_bd.sh for which direction each BD script moves.
# Set ALLOW_STALE_BD=1 to downgrade the check to a warning.
ALLOW_STALE_BD ?= 0
CHECK_BD := PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) NO_UPDATE=$(NO_UPDATE) \
            ALLOW_STALE_BD=$(ALLOW_STALE_BD) $(SCRIPTS_DIR)/helpers/check_bd.sh

# Set ALLOW_MISSING_PINS=1 to build a project whose BD tcl connects pins that no
# longer exist (dropping those connections) instead of failing.
ALLOW_MISSING_PINS ?= 0


.PHONY: new project synth impl check-bd update sim sdt boot bsp overlay dtbo deploy mb elf-mb clean-mb

default: help

help:
	@echo vivgit main interface, available commands:

# -- shell
new:
	cp $(SCRIPTS_DIR)/bootstrap/templates/zynq_ultra.tcl bd/$(PROJECT).tcl
	sed -i 's/base_zynq/$(PROJECT)/g' bd/$(PROJECT).tcl

# Reports whether the project's BD matches the checked-in tcl. Run it on its own
# to check without building anything.
check-bd:
	@$(CHECK_BD) freshness

# -- vivado
project:
	@$(CHECK_BD) overwrite
ifeq ($(NO_UPDATE),0)
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/update_bd.tcl
endif
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) PART_NAME=$(PART_NAME) BOARD_NAME=$(BOARD_NAME) \
	ALLOW_MISSING_PINS=$(ALLOW_MISSING_PINS) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/create_project.tcl

synth: project
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) NJOBS=$(NJOBS) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_synth.tcl

# Implementation only -- deliberately does NOT depend on synth/project, so a
# different IMPL_STRATEGY can be tried against an existing synthesis run.
# (`project` runs create_project -force, which would discard that synthesis.)
# launch_runs will still re-run synth_1 itself if it's stale. The guard below
# catches the one case that used to pass silently: implementing a project whose
# BD is older than the checked-in tcl.
impl:
	@$(CHECK_BD) freshness
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) NJOBS=$(NJOBS) IMPL_STRATEGY=$(IMPL_STRATEGY) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_impl.tcl

update:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/update_bd.tcl

sim:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) TB=$(TB) SIM_TIME="$(SIM_TIME)" \
	$(RUN_VIVADO) $(SCRIPTS_DIR)/vivado/run_sim.tcl

# -- xsct
sdt:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) BOARD_DTS=$(BOARD_DTS) \
	$(RUN_XSCT) $(SCRIPTS_DIR)/xsct/generate_sdt.tcl

boot:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) BOOT_FW_DIR=$(BOOT_FW_DIR) PLNX_PROJECT=$(PLNX_PROJECT) \
	BL31_ELF=$(BL31_ELF) UBOOT_ELF=$(UBOOT_ELF) SYSTEM_DTB=$(SYSTEM_DTB) ALLOW_INCOMPLETE_BOOT=$(ALLOW_INCOMPLETE_BOOT) \
	$(RUN_XSCT) $(SCRIPTS_DIR)/xsct/generate_boot.tcl

# -- vitis
bsp:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	$(RUN_VITIS) $(SCRIPTS_DIR)/vitis/generate_bsp.py

# -- others
overlay: sdt
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) \
	python3 $(SCRIPTS_DIR)/helpers/generate_overlay.py

dtbo:
	dtc -@ -I dts -O dtb -o $(BUILD_DIR)/$(PROJECT).dtbo $(BUILD_DIR)/$(PROJECT)_overlay.dtsi
# Note: dtbo does not have overlay as a dependency since the user might want to modify it themself

deploy:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) BOARD_DEST=$(BOARD_DEST) BOARD_HOST=$(BOARD_HOST) \
	$(SCRIPTS_DIR)/board/deploy.sh

# -- microblaze
mb:
	@mkdir $(MB_DIR)/$(MB_PROJECT)
	@cp $(SCRIPTS_DIR)/bootstrap/Makefile.microblaze $(MB_DIR)/$(MB_PROJECT)/Makefile

elf-mb:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) MB_PROJECT=$(MB_PROJECT) \
	$(MAKE) -C $(MB_DIR)/$(MB_PROJECT)

clean-mb:
	PROJECT=$(PROJECT) PROJECT_ROOT=$(PROJECT_ROOT) MB_PROJECT=$(MB_PROJECT) \
	$(MAKE) -C $(MB_DIR)/$(MB_PROJECT) clean
