# Build of one Microblaze app, microblaze/<app>/*.c. Included by the stub
# Makefile that `make mb` installs in the app directory (per-app settings such
# as OPT or LSCRIPT go above the include there), or run through
# `make PROJECT=<proj> MB_PROJECT=<app> elf-mb` from the project root.

# Project root: set by the stub, otherwise two levels above this Makefile
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PROJECT_ROOT ?= $(abspath $(MAKEFILE_DIR)/../..)

# Same optional configuration files as Makefile.main
-include $(PROJECT_ROOT)/config.mk

# --- Project info
PROJECT ?= unset

ifeq ($(PROJECT),unset)
$(error PROJECT not set, please specify the name of the target project)
endif

-include $(PROJECT_ROOT)/config/$(PROJECT).mk

MB_PROJECT ?= $(notdir $(CURDIR))

# --- Xilinx installation info ----
XILINX_ROOT    ?= /opt/Xilinx
XILINX_VERSION ?= 2024.2
export XILINX_ROOT
export XILINX_VERSION

# --- Dirs and file locations
SRC_DIR     := $(PROJECT_ROOT)/microblaze
SCRIPTS_DIR := $(PROJECT_ROOT)/scripts
BUILD_DIR   := $(PROJECT_ROOT)/build/$(PROJECT)

# `make bsp` writes bsp.mk with what Vitis generated for this design:
#   BSP_DIR        headers, libraries and specs file of the BSP
#   BSP_LSCRIPT    linker script for the design's memory map
#   MB_ARCH_FLAGS  -march/-mabi of the Microblaze-V (32/64-bit, extensions)
#   MB_CPU         the CPU instance it was built for
BSP_MK := $(BUILD_DIR)/bsp.mk
-include $(BSP_MK)
ifeq ($(BSP_DIR),)
ifneq ($(MAKECMDGOALS),clean)
$(error $(BSP_MK) not found, run `make PROJECT=$(PROJECT) bsp` first)
endif
endif

BSP_INC     := $(BSP_DIR)/include
BSP_LIB     := $(BSP_DIR)/lib
SPECS_FILE  := $(BSP_DIR)/Xilinx.spec

# Linker script: the app's own lscript.ld if it has one (e.g. to change the
# stack/heap sizes or place code in DDR), otherwise the one `make bsp`
# generated from the design's memory map.
APP_LSCRIPT := $(SRC_DIR)/$(MB_PROJECT)/lscript.ld
LSCRIPT     ?= $(if $(wildcard $(APP_LSCRIPT)),$(APP_LSCRIPT),$(BSP_LSCRIPT))

# --- Sources
SRCS := $(wildcard $(SRC_DIR)/$(MB_PROJECT)/*.c)
OBJS := $(patsubst $(SRC_DIR)/$(MB_PROJECT)/%.c,$(SRC_DIR)/$(MB_PROJECT)/%.o,$(SRCS))
DEPS := $(patsubst $(SRC_DIR)/$(MB_PROJECT)/%.c,$(SRC_DIR)/$(MB_PROJECT)/%.d,$(SRCS))

# --- Toolchain
CC      := riscv64-unknown-elf-gcc
OBJCOPY := riscv64-unknown-elf-objcopy
OBJDUMP := riscv64-unknown-elf-objdump
# Optimization/debug level (Vitis builds apps with -O2)
OPT     ?= -O0 -g
# Section flags mirror the BSP's microblaze_riscv_toolchain.cmake, which Vitis
# uses for its own app builds: one section per function/object so that
# --gc-sections drops unused BSP and libc code (needed to fit a 16 KB BRAM),
# and --no-relax so the code does not depend on gp being set up.
CFLAGS  := $(OPT) -DSDT -MMD -MP $(MB_ARCH_FLAGS) \
           -ffunction-sections -fdata-sections -fno-tree-loop-distribute-patterns -Wall -Wextra
LDFLAGS := -L$(BSP_LIB) -Wl,--no-relax -Wl,--gc-sections \
           -Wl,--start-group -lxilstandalone -lxil -Wl,--end-group -lc -lm -lgcc -specs=$(SPECS_FILE) -T $(LSCRIPT)

# --- Wrapped commands
RUN_CC      := $(SCRIPTS_DIR)/env/run_cmd.sh $(CC)
RUN_OBJCPY  := $(SCRIPTS_DIR)/env/run_cmd.sh $(OBJCOPY)
RUN_OBJDUMP := $(SCRIPTS_DIR)/env/run_cmd.sh $(OBJDUMP)

# --- Targets
all: $(MB_PROJECT).elf $(MB_PROJECT).bin $(MB_PROJECT).dump

$(MB_PROJECT).elf: $(OBJS) $(LSCRIPT) $(BSP_MK)
	$(RUN_CC) $(CFLAGS) -I$(BSP_INC) $(OBJS) $(LDFLAGS) -o $@

$(MB_PROJECT).bin: $(MB_PROJECT).elf
	$(RUN_OBJCPY) -O binary $< $@

$(MB_PROJECT).dump: $(MB_PROJECT).elf
	$(RUN_OBJDUMP) -d $< > $@

%.o: %.c
	$(RUN_CC) $(CFLAGS) -I$(BSP_INC) -c $< -o $@

# Recompile after `make bsp` (new headers, possibly other ISA flags) and when
# an included header changes
$(OBJS): $(BSP_MK)
-include $(DEPS)

clean:
	rm -f $(OBJS) $(DEPS) $(MB_PROJECT).elf $(MB_PROJECT).bin $(MB_PROJECT).dump

.PHONY: all clean