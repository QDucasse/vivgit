# --- Xilinx installation info ----
XILINX_ROOT    ?= /opt/Xilinx
XILINX_VERSION ?= 2024.2
export XILINX_ROOT
export XILINX_VERSION

# --- Project info
PROJECT ?= unset

ifeq ($(PROJECT),unset)
$(error PROJECT not set, please specify the name of the target project)
endif

MB_PROJECT ?= $(notdir $(CURDIR))

# Instance name of the Microblaze in the block design (must match `make bsp`)
MB_CPU ?= microblaze_riscv_0

# Directory of the current Makefile
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Project root is the parent of the Makefile directory
PROJECT_ROOT ?= $(abspath $(MAKEFILE_DIR)/../..)

# --- Dirs and file locations
SRC_DIR     := $(PROJECT_ROOT)/microblaze
SCRIPTS_DIR := $(PROJECT_ROOT)/scripts
BUILD_DIR   := $(PROJECT_ROOT)/build/$(PROJECT)

BSP_DIR     := $(BUILD_DIR)/$(PROJECT).vitis/$(PROJECT)_platform/$(MB_CPU)/standalone_$(MB_CPU)/bsp
BSP_INC     := $(BSP_DIR)/include
BSP_LIB     := $(BSP_DIR)/lib
SPECS_FILE  := $(BSP_DIR)/Xilinx.spec

# ISA flags of the Microblaze-V (-march/-mabi), as configured in the block
# design (32/64-bit, optional extensions). `make bsp` records them in the
# BSP's cflags.yaml, which is the single source of truth.
MB_ARCH_FLAGS ?= $(shell sed -n 's/^cflags: *//p' $(BSP_DIR)/cflags.yaml 2>/dev/null)
ifeq ($(strip $(MB_ARCH_FLAGS)),)
ifneq ($(MAKECMDGOALS),clean)
$(error no ISA flags in $(BSP_DIR)/cflags.yaml, run `make PROJECT=$(PROJECT) bsp` first (or set MB_ARCH_FLAGS))
endif
endif

# --- Sources
SRCS := $(wildcard $(SRC_DIR)/$(MB_PROJECT)/*.c)
OBJS := $(patsubst $(SRC_DIR)/$(MB_PROJECT)/%.c,$(SRC_DIR)/$(MB_PROJECT)/%.o,$(SRCS))
DEPS := $(patsubst $(SRC_DIR)/$(MB_PROJECT)/%.c,$(SRC_DIR)/$(MB_PROJECT)/%.d,$(SRCS))

# --- Toolchain
CC      := riscv64-unknown-elf-gcc
OBJCOPY := riscv64-unknown-elf-objcopy
OBJDUMP := riscv64-unknown-elf-objdump
# Optimization/debug level (Vitis builds apps with -O2)
OPT     ?= -O0 -g
# Section flags mirror the BSP's microblaze_riscv_toolchain.cmake, which Vitis
# uses for its own app builds: one section per function/object so that
# --gc-sections drops unused BSP and libc code (needed to fit a 16 KB BRAM),
# and --no-relax so the code does not depend on gp being set up.
CFLAGS  := $(OPT) -DSDT -MMD -MP $(MB_ARCH_FLAGS) \
           -ffunction-sections -fdata-sections -fno-tree-loop-distribute-patterns -Wall -Wextra
LDFLAGS := -L$(BSP_LIB) -Wl,--no-relax -Wl,--gc-sections \
           -Wl,--start-group -lxilstandalone -lxil -Wl,--end-group -lc -lm -lgcc -specs=$(SPECS_FILE) -T lscript.ld

# Trying with -T $(LDS), but it overwrites the main linker script...

# --- Wrapped commands
RUN_CC      := $(SCRIPTS_DIR)/env/run_cmd.sh $(CC)
RUN_OBJCPY  := $(SCRIPTS_DIR)/env/run_cmd.sh $(OBJCOPY)
RUN_OBJDUMP := $(SCRIPTS_DIR)/env/run_cmd.sh $(OBJDUMP)

# --- Targets
all: $(MB_PROJECT).elf $(MB_PROJECT).bin $(MB_PROJECT).dump

$(MB_PROJECT).elf: $(OBJS)
	$(RUN_CC) $(CFLAGS) -I$(BSP_INC) $^ $(LDFLAGS) -o $@

$(MB_PROJECT).bin: $(MB_PROJECT).elf
	$(RUN_OBJCPY) -O binary $< $@

$(MB_PROJECT).dump: $(MB_PROJECT).elf
	$(RUN_OBJDUMP) -d $< > $@

%.o: %.c
	$(RUN_CC) $(CFLAGS) -I$(BSP_INC) -c $< -o $@

clean:
	rm -f $(OBJS) $(DEPS) $(MB_PROJECT).elf $(MB_PROJECT).bin