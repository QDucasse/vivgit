# Example configuration for vivgit, copy it to the project root as:
#   config.mk             for the whole repository
#   config/<PROJECT>.mk   for one project (read after config.mk)
#
# Every line is commented out and shows the default from
# scripts/bootstrap/Makefile.main: uncomment and change only what you need.
# Use plain assignments (=). The command line still overrides these.
#
# Per-run switches (NO_UPDATE, ALLOW_*, TB, SIM_TIME, IMPL_STRATEGY) are
# meant for the command line and are left out on purpose.

# ---- Board ----
# PART_NAME  = xczu7ev-ffvc1156-2-e
# BOARD_NAME = xilinx.com:zcu104:part0:1.1
# BOARD_DTS  = zcu104-revc

# Block design template used by `make new` (scripts/bootstrap/templates/<TEMPLATE>.tcl)
# TEMPLATE = zynq_ultra

# Directory holding prebuilt bl31.elf, u-boot.elf and system.dtb for `make boot`
# (or PLNX_PROJECT = <petalinux project>, which uses its images/linux)
# BOOT_FW_DIR =

# ---- Toolchain ----
# XILINX_ROOT    = /opt/Xilinx
# XILINX_VERSION = 2024.2

# Parallel jobs for synthesis/implementation
# NJOBS = 8

# ---- Microblaze ----
# Instance names in the block design, for `make bsp` and the Microblaze builds
# MB_CPU  = microblaze_riscv_0
# MB_UART = axi_uartlite_0
